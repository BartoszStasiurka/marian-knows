{
  "name": "marian-knows",
  "version": "0.1.0",
  "description": "Markdown knowledge base with full-text search (SQLite FTS5), CLI first.",
  "type": "module",
  "license": "MIT",
  "author": "Bartosz Stasiurka <bstasiurka@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BartoszStasiurka/marian-knows.git"
  },
  "homepage": "https://github.com/BartoszStasiurka/marian-knows#readme",
  "bugs": {
    "url": "https://github.com/BartoszStasiurka/marian-knows/issues"
  },
  "keywords": [
    "markdown",
    "knowledge-base",
    "full-text-search",
    "sqlite",
    "fts5",
    "mcp",
    "mcp-server",
    "cli"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "marian-knows": "dist/cli.js"
  },
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "prepack": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^12.11.1",
    "fast-glob": "^3.3.2",
    "yaml": "^2.5.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.14.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}